# Public deployment settings. Copy to .env.production and fill real values.
APP_ENV=production

# Set this to your real frontend origin after you obtain a domain.
# Example: https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

# Do not expose raw user-submitted messages in anonymous public-demo mode.
PERSIST_RAW_MESSAGE_TEXT=false

# Use a production PostgreSQL URL from a secret manager or deployment platform.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@DATABASE_HOST:5432/sentinelai

# Public frontend API base.
VITE_API_BASE_URL=/api

# Required in production. Generate with:
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
MESSAGE_FINGERPRINT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
